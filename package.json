{
  "name": "contextquant",
  "version": "0.3.0",
  "description": "MCP proxy that shrinks tool results for AI agents and says exactly what it cut, with a tool to get it back.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khankaif/ContextQuant.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "llm",
    "agents",
    "tokens",
    "context",
    "claude",
    "proxy"
  ],
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "contextquant": "src/cli.ts",
    "cq": "src/cli.ts"
  },
  "files": [
    "src",
    "bench/people.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "test": "bun test",
    "bench": "bun src/cli.ts bench",
    "build": "bun build src/cli.ts --compile --outfile dist/cq",
    "mcp": "bun src/cli.ts gateway"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@toon-format/toon": "4.1.1",
    "js-tiktoken": "1.0.21",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/bun": "1.3.8",
    "typescript": "5.9.3"
  }
}
